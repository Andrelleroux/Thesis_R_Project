library(tidyverse)
library(plm)
library(stargazer)

Two_Way_Fix_Eff <- function(){

    Init_Data = read_csv("data/Data_PWT.csv")

    Countries <- c("ARG", "AUS", "AUT", "BEL", "BRA", "CAN", "CHE", "COL",
                   "DEU", "DNK", "ESP", "FIN", "FRA", "GBR", "IND", "ITA", "JPN",
                   "MEX", "NGA", "NLD", "NOR", "PHL", "SWE", "THA", "TUR",
                   "USA", "VEN", "ZAF")

    Model_Data_TWFE <- Init_Data %>%
        mutate(ln_Gdp = log(rgdpe)) %>%
        mutate(l_pop = log(pop)) %>%
        mutate(Labour_Ratio = emp/pop) %>%
        filter(countrycode %in% Countries) %>%
        mutate(l_cn = log(cn)) %>%
        mutate(hc = ifelse(is.na(hc), 1.15172, hc)) %>%
        select(countrycode, year, ln_Gdp, l_pop, hc, l_cn)

    Two_Way_Fixed_Mod <- plm(ln_Gdp ~ l_pop + hc + l_cn, data = Model_Data_TWFE, model = "within", effect = "twoways")

    country_effects <- fixef(Two_Way_Fixed_Mod, effect = "individual")
    time_effects <- fixef(Two_Way_Fixed_Mod, effect = "time")

}