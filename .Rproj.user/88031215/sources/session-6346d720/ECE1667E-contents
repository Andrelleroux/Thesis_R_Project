library(tidyverse)

reshaped_data <- Model_Data %>% select(countrycode, ln_Gdp, year)%>%
    pivot_wider(names_from = countrycode, values_from = ln_Gdp) %>%
    arrange(year) %>%select(-year) %>%  as.matrix()

testing <- Test_Data %>% select(countrycode, ln_Gdp, year)%>%
    pivot_wider(names_from = countrycode, values_from = ln_Gdp) %>%
    arrange(year) %>%select(-year) %>%  as.matrix()

learning_rate = 0.01

Init_w <- function(n_countries = 28) {
    W <- matrix(rnorm(n_countries^2, mean = 0, sd = sqrt(2 / n_countries)), nrow = n_countries, ncol = n_countries)
    diag(W) <- 0
    return(W)
}

pred_GDP <- function(matrix = reshaped_data, weights = W){

    predicted_val = matrix %*% weights
}

Error <- function(matrix_act = reshaped_data, matrix_pred = pred_matrix, n_countries = 28){

    calc_diff <- sum((matrix_pred - matrix_act)^2)

    return(calc_diff * (1/(2*n_countries)))

}

Error_deriv <- function(matrix_act = reshaped_data, matrix_pred = pred_matrix){

    deriv <- 2 * (matrix_pred - matrix_act)
    return(deriv)
}

W <- Init_w(28)

grad_weights <- matrix(0, nrow = 28, ncol = 28)

for (i in 1:1000) {

    pred_matrix <- pred_GDP(reshaped_data, W)

    for (i in 1:28) {
        for (j in 1:28) {
            if (i != j) {  # Skip diagonal elements
                grad_weights[i, j] <- sum(2 * (pred_matrix[, i] - reshaped_data[, i]))
            }
        }
    }
    W <- W - learning_rate * grad_weights

}

print(W)

Error()/28

Back_test_pred <- pred_GDP(matrix = testing, weights = W)

Back_RMSE <- sqrt(mean((Test_Data$ln_Gdp - Back_test_pred)^2))
