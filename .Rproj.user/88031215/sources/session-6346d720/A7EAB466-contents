library(tidyverse)
library(caret)

Ensemble_Model <- function(data = Model_Data){

    pdata_Model_Data <- pdata.frame(data, index = c("countrycode", "year"))

    pred_Two_Way_Ens <- predict(Two_Way_Fixed_Mod, newdata = pdata_Model_Data)

    TW_df <- pred_Two_Way_Ens %>% as.data.frame()

    Ens_df <- Model_Data %>% select(ln_Gdp, countrycode, year) %>%
        mutate(fitted_TW = as.numeric(unlist(TW_df))) %>%
        left_join(., fitted_values_OLS, by = c("countrycode", "year")) %>%
        left_join(., fitted_values_ARIMA, by = c("countrycode", "year")) %>%
        left_join(., fitted_values_mlrMBO, by = c("countrycode", "year")) %>%
        mutate(ln_Gdp = ln_Gdp.x) %>%
        select(-countrycode, -year, -ln_Gdp.y, -ln_Gdp.x) %>% as.data.frame()

    y <- Ens_df$ln_Gdp
    x <- Ens_df %>% select(-ln_Gdp)

    train_control <- trainControl(method = "cv", number = 10)

    stack_model <- train(
        x, y,
        method = "lm",
        trControl = train_control
    )
    stack_model$finalModel$coefficients


}