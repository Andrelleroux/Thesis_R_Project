"regr.gbm",
predict.type = "response"
)
# Set hyperparameters directly
final_learner <- setHyperPars(learner, par.vals = list(
n.trees = 490,
interaction.depth = 15,
n.minobsinnode = 5,
shrinkage = 0.111
))
# Step 3: Train the model with hardcoded parameters
